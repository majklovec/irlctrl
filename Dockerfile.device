# Device image — runs `backend/client/client.ts` in the `relay` or `encoder` role.
#
# Unlike the control image (Dockerfile), this bundles the device runtime:
#   - backend/client/ + shared/ + modules/ (the relay/encoder client),
#   - the native streaming binaries (srtla_send, ceracoder, belacoder),
#   - the GStreamer pipeline definitions (pipeline/),
#   - GStreamer itself, since ceracoder/belacoder drive the encode pipeline.
#
# Pick the role per container with `--role` (see docker-compose.yaml):
#   relay   -> bonds SRT out via srtla_send (needs no root in-container)
#   encoder -> runs ceracoder/belacoder and sends SRT to a relay
#
# SRT is built from the CERALIVE fork (Haivision 1.5.7 + BELABOX patches), the
# same source the Armbian device image uses (armbian/userpatches/
# customize-image.sh). The committed ceracoder/belacoder binaries link against
# this fork. It is kept in a separate build stage so the runtime image stays
# free of the C/C++ toolchain.
FROM oven/bun:1 AS srt-builder

RUN apt-get update && apt-get install -y --no-install-recommends \
    build-essential cmake git libssl-dev ca-certificates \
    && rm -rf /var/lib/apt/lists/*

WORKDIR /srt
RUN git clone --depth=1 https://github.com/CERALIVE/srt.git . \
    && mkdir -p build && cd build \
    && cmake .. -DCMAKE_INSTALL_PREFIX=/usr/local \
    -DENABLE_ENCRYPTION=ON -DCRYPTO=openssl \
    && make -j"$(nproc)" \
    && make install

# ---- Bun build stage ----
FROM oven/bun:1 AS builder

WORKDIR /app

# Copy dependency manifests first for better layer caching
COPY package.json bun.lock ./
RUN bun install --frozen-lockfile

# Copy the rest of the project
COPY . .

# ---- Runtime stage ----
FROM oven/bun:1

# GStreamer (ceracoder/belacoder encode pipelines), git (pipeline repos),
# iproute2 (the relay detects uplinks via `ip -o -4 addr show` and watches them
# with `ip monitor`), ca-certificates (TLS for wss:// control servers),
# openssh-server (the ssh module lets the operator start/stop it and reset the
# root password).
# NOTE: SRT is NOT apt-installed here — it is built from the CERALIVE fork in
# the `srt-builder` stage and copied in below.
RUN apt-get update && apt-get install -y --no-install-recommends \
    git \
    ca-certificates \
    iproute2 \
    openssh-server \
    gstreamer1.0-tools \
    gstreamer1.0-plugins-base gstreamer1.0-plugins-good \
    gstreamer1.0-plugins-bad gstreamer1.0-plugins-ugly \
    gstreamer1.0-libav gstreamer1.0-x \
    && rm -rf /var/lib/apt/lists/*

# The CERALIVE SRT fork (v1.5.7) installs as /usr/local/lib/libsrt.so.1.5.7,
# but the committed ceracoder/belacoder binaries were linked against the
# libsrt.so.1 soname. Copy the built tree and bridge the soname so the loader
# resolves libsrt.so.1 to the fork.
COPY --from=srt-builder /usr/local/lib /usr/local/lib
RUN ln -s /usr/local/lib/libsrt.so.1.5.7 /usr/lib/x86_64-linux-gnu/libsrt.so.1 \
    && ldconfig

WORKDIR /app

# Copy only what is needed to run the device. The client runs unbundled
# (`bun backend/client/client.ts`): modules are discovered by a runtime scan of modules/ and
# dynamically imported, and the web UI is bundled at startup on the fly.
COPY --from=builder /app/package.json /app/bun.lock ./
COPY --from=builder /app/node_modules ./node_modules
COPY --from=builder /app/backend/client ./backend/client
COPY --from=builder /app/modules ./modules
COPY --from=builder /app/frontend ./frontend
COPY --from=builder /app/shared ./shared
COPY --from=builder /app/i18n ./i18n
COPY --from=builder /app/scripts ./scripts
# tsconfig.json drives the JSX transform at bundle time (jsxFactory "m" ->
# Mithril). Without it Bun defaults to react/jsx-dev-runtime, which isn't a dep.
COPY --from=builder /app/tsconfig.json ./tsconfig.json

# generated/ is gitignored and regenerated at startup (scripts/gen-modules.ts) —
# create it writable by the runtime user (1000:1000).
RUN mkdir -p /app/generated && chown 1000:1000 /app/generated

# Native streaming binaries + GStreamer pipeline definitions (from the build
# context, committed at the repo root).
COPY srtla_send ceracoder belacoder ./
COPY pipeline ./pipeline
RUN chmod +x ./srtla_send ./ceracoder ./belacoder

# Expose the device's local web UI / WebSocket API port
EXPOSE 8085

# Default entrypoint — override `command` in docker-compose to set the role.
ENTRYPOINT ["bun", "backend/client/client.ts"]
CMD ["--host", "0.0.0.0", "--port", "8085", "--role", "relay", "--pipelines", "/app/pipeline"]
