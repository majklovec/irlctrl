{
    "name": "irlctrl",
    "version": "7.6.0",
    "description": "IRL control application",
    "author": "Michal Vondráček",
    "scripts": {
        "gen:modules": "bun scripts/gen_modules.ts",
        "gen:pages": "bun scripts/gen_pages.ts",
        "i18n": "bun scripts/i18n.ts",
        "predev": "bun scripts/gen_modules.ts && bun scripts/gen_pages.ts",
        "pretest": "bun scripts/gen_pages.ts && bun scripts/gen_control_server_assets.ts",
        "dev:server": "bun server/main.ts",
        "dev:client": "bun client/backend/client.ts",
        "test": "bun test --parallel=8",
        "smoke": "bun scripts/smoke.ts",
        "prebuild:client": "bun scripts/gen_pages.ts && bun scripts/gen_control_server_assets.ts",
        "build:client": "bun build --compile --minify --sourcemap --format=esm --bytecode ./client/backend/client.ts --outfile dist/client && bun build --compile --minify --sourcemap --format=esm --bytecode ./client/backend/client.ts --outfile dist/client-arm --target=bun-linux-arm64",
        "prebuild:server": "bun scripts/gen_pages.ts && bun scripts/gen_control_server_assets.ts",
        "build:server": "bun build --compile --minify --sourcemap --format=esm --bytecode ./server/main.ts --outfile dist/server"
    },
    "devDependencies": {
        "@semantic-release/changelog": "^7.0.0",
        "@semantic-release/git": "^11.0.1",
        "@types/bun": "^1.4.2",
        "@types/mithril": "^2.2.9",
        "@types/node": "^26.6.3",
        "@types/qrcode": "^1.5.6",
        "@types/ws": "^8.18.2",
        "bun-plugin-glob-import": "^1.1.1",
        "happy-dom": "^21.0.4",
        "typescript": "^7.0.2"
    },
    "dependencies": {
        "@elysia/static": "^1.4.11",
        "elysia": "^1.4.30",
        "gridstack": "^11",
        "i18next": "^26.4.6",
        "i18next-browser-languagedetector": "^8.2.2",
        "i18next-http-backend": "^4.0.3",
        "mithril": "^2.3.8",
        "qrcode": "^1.5.4",
        "tiktok-live-connector": "^2.5.0",
        "youtube-chat-next": "^3.1.0"
    }
}
