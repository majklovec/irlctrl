# Template for .env — copy to .env and fill in real values.
# .env is gitignored; this file is committed as a reference.
#
# Resolution order is the same everywhere: CLI flag > env var > config file > default.
# Only uncomment / fill in the sections for the services the file drives.

# ================================================================
# Control server (backend/server/server.ts)
# ================================================================
SERVER_HOST=0.0.0.0
SERVER_PORT=8090
# SQLite database: users, device tokens, dashboards (default users.db)
DB_FILE=
# Local testing only — one shared "local" profile, no tokens/database
#NO_AUTH=1

# ================================================================
# Device client — relay / encoder (backend/client/client.ts)
# ================================================================
# relay | encoder | combined (default relay)
ROLE=
# Local web UI / WebSocket API (default 127.0.0.1:8085)
API_HOST=
API_PORT=
# Extra browser origins for /ws (comma-separated, * = any)
ALLOWED_ORIGINS=
# Device config file (default: tmpdir config.json; use a persistent path in production)
CONFIG_FILE=
# Persistent event log shown in the web UI (default: tmpdir srtla_log.json)
LOG_FILE=
# Print ip/process actions instead of running them
#DRY_RUN=1
# Uplinks file for srtla_send (default: tmpdir srtla_ips.txt)
UPLINKS_FILE=
# Interface-event debounce in ms (default 1500)
DEBOUNCE_MS=
# signal | restart (default signal)
SRTLA_RELOAD_MODE=
# srtla_send control socket (default: tmpdir srtla_send.sock; "" disables it)
SRTLA_CONTROL_SOCKET=
# srtla_send binary (env only, default srtla_send)
SRTLA_SEND_BIN=
# Pipeline files directory (default /usr/share/belacoder/pipelines)
PIPELINES_DIR=
# Encoder binary (default belacoder; "ceracoder" switches to INI-config mode)
ENCODER_BIN=
# belacoder bitrate file (default: tmpdir belacoder_br)
BITRATE_FILE=
# ceracoder INI config (default: tmpdir ceracoder.conf)
CERACODER_CONF=

# ================================================================
# Control server connection (shared by client, obs-client, broadcaster)
# ================================================================
CONTROL_SERVER_URL=wss://your-server.example.com/device
CONTROL_SERVER_TOKEN=
# Periodic status push in seconds (0 = only on change; default 30)
CONTROL_SERVER_INTERVAL=
# srtla_send link-stats push interval in seconds (0 = off; default 2)
CONTROL_SERVER_STATS_INTERVAL=

# ================================================================
# OBS client (backend/obs-client/obs-client.ts)
# ================================================================
OBS_URL=ws://host.docker.internal:4455
OBS_PASSWORD=
# Device name shown in the control server
DEVICE_HOSTNAME=
# Explicit fixed device identity (default: auto-assigned and persisted)
DEVICE_UUID=
# OBS client config file (default: tmpdir obs-client-config.json)
#CONFIG_FILE=

# ================================================================
# Broadcaster (backend/broadcaster/broadcaster.ts)
# ================================================================
# Broadcaster config file (default: tmpdir broadcaster-config.json)
#CONFIG_FILE=
#ts | h264 (default ts)
INPUT_FORMAT=
# SRTLA listener port (default 6000)
SRTLA_PORT=
# SRT receive port (default 7000)
SRT_PORT=
# SRT latency hint in ms (default 120)
SRT_LATENCY_MS=
# ffmpeg output profiles directory (default: app data dir / profiles)
PROFILES_DIR=
# SRTLA agent web metrics port (default 9090)
SRTLA_METRICS_PORT=
# SRT bind host (default 0.0.0.0)
SRT_BIND_HOST=
# Start streaming immediately on launch
#AUTOSTART=1
#DRY_RUN=1
#
# Where the de-bonded SRTLA stream is re-published as RTMP.
# RTMP_KEY is the stream key, appended to RTMP_URL as the final path segment
# (rtmp://host/live + your-stream-key → rtmp://host/live/your-stream-key).
# These are first-run bootstrap values only: once the destination is saved from
# the web UI it is written to the config file and takes precedence over them,
# so the values set here are ignored afterwards.
RTMP_URL=rtmp://your-ingest.example.com/live
RTMP_KEY=your-stream-key
# Dynamic RTMP URL source file (rtmp-url-file flag)
RTMP_URL_FILE=
